# Used ONLY by `docker compose up` — Compose reads `.env` from the same
# directory as docker-compose.yml (this repo's root) for `${VAR}`
# substitution inside that file. This is unrelated to packages/api/.env or
# apps/client/.env, which the app itself reads when run outside Docker
# (`bun dev`) — see those packages' own .env.example files for that.
#
#   cp .env.example .env

# Required — docker-compose.yml fails fast (Compose's own ${VAR:?...}
# syntax) if this is unset. generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Optional, paired — leave both unset to run username/password only in
# the Docker stack. See packages/api/.env.example for the Google Cloud
# Console setup step (same redirect URI shape: http://localhost:3000/api/auth/callback/google).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
