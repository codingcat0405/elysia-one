PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elysia-template

# Required — boot fails fast if missing. 32+ chars.
# generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public origin of THIS api, used for OAuth callback construction.
# Defaults to http://localhost:${PORT}. Must be the exact public URL in prod.
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — OPTIONAL. Google sign-in is enabled only when BOTH are set;
# boot fails fast if exactly one is set.
# MANUAL STEP (cannot be automated): create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials and register this exact
# Authorized redirect URI:  ${BETTER_AUTH_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Exact browser origin(s) of apps/client, comma-separated. Required for
# credentialed CORS — a wildcard origin makes the browser discard the
# auth cookies. Also doubles as Better Auth's `trustedOrigins` (Origin/Referer
# check on state-changing requests). Defaults to the vite dev port.
CLIENT_URL=http://localhost:3001

# pool sizing: this is a per-process pool. Horizontal scaling is via multiple
# replicas (e.g. k8s), not in-process clustering — total Postgres connections
# = replica count * DB_POOL_MAX, keep that under Postgres max_connections.
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=30000

# swagger requires an explicit opt-in — it is NOT auto-enabled based on
# NODE_ENV, in dev or prod:
# ENABLE_SWAGGER=true

# Required — boot fails fast if missing. Used by:
# - MikroORM result cache: src/utils/RedisCacheAdapter.ts (adapter is wired
#   in as the default; no query currently opts in with `cache: [...]`, so it
#   has zero effect today — safe to start using per-query at any time)
# - BullMQ job queue + worker (src/worker.ts)
REDIS_URL=redis://localhost:6379

# jobs processed in parallel per worker process (src/worker.ts)
WORKER_CONCURRENCY=5

# Bull Board dashboard at /bull-board — protected by HTTP Basic Auth
ENABLE_BULL_BOARD=false
# If ENABLE_BULL_BOARD is true, you must set these variables
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# production switches winston to structured JSON logs and marks the session
# cookie Secure (HTTPS-only) — see packages/api/README.md "Deploying with
# cookie auth"
# NODE_ENV=production

# winston log level. Defaults to "debug" in dev, "info" when NODE_ENV=production
# LOG_LEVEL=info
