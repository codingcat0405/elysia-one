PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elysia-template

# generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Required — boot fails fast if missing, and must NOT equal JWT_SECRET.
# Separate secret for the refresh token so an access token can never be
# replayed at /api/users/refresh. generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Exact browser origin(s) of apps/client, comma-separated. Required for
# credentialed CORS — a wildcard origin makes the browser discard the
# auth cookies. Defaults to the vite dev port.
CLIENT_URL=http://localhost:3001

# Leave UNSET in local dev (localhost cookies are shared across ports).
# In production set it to the shared parent domain when the client and the
# API are on different subdomains, e.g. .example.com — otherwise the auth
# cookie is host-only to the API and the client's SSR server never sees it.
# COOKIE_DOMAIN=

# pool sizing: this is a per-process pool. Horizontal scaling is via multiple
# replicas (e.g. k8s), not in-process clustering — total Postgres connections
# = replica count * DB_POOL_MAX, keep that under Postgres max_connections.
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=30000

# swagger is auto-enabled outside production; opt-in for prod:
# ENABLE_SWAGGER=true

# Required — boot fails fast if missing. Used by:
# - MikroORM result cache: src/utils/RedisCacheAdapter.ts
# - Redis Lock: src/utils/RedisLock.ts (distributed locks for non-racy critical sections)
# - BullMQ job queue + worker (src/worker.ts)
REDIS_URL=redis://localhost:6379

# jobs processed in parallel per worker process (src/worker.ts)
WORKER_CONCURRENCY=5

# Bull Board dashboard at /bull-board — protected by HTTP Basic Auth
ENABLE_BULL_BOARD=false
# If ENABLE_BULL_BOARD is true, you must set these variables
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=