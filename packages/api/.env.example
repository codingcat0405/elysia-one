PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elysia-template

# generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# pool sizing: this is a per-process pool. Horizontal scaling is via multiple
# replicas (e.g. k8s), not in-process clustering — total Postgres connections
# = replica count * DB_POOL_MAX, keep that under Postgres max_connections.
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=30000

# swagger is auto-enabled outside production; opt-in for prod:
# ENABLE_SWAGGER=true

# Required — boot fails fast if missing. Used by:
# - MikroORM result cache: src/utils/RedisCacheAdapter.ts
# - Redis Lock: src/utils/RedisLock.ts (distributed locks for non-racy critical sections)
# - BullMQ job queue + worker (src/worker.ts)
REDIS_URL=redis://localhost:6379

# jobs processed in parallel per worker process (src/worker.ts)
WORKER_CONCURRENCY=5

# Bull Board dashboard at /bull-board — protected by HTTP Basic Auth
ENABLE_BULL_BOARD=false
# If ENABLE_BULL_BOARD is true, you must set these variables
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=